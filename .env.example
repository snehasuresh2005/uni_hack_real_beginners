# LLM Provider Configuration & Failover Redundancy Chain
# Failover Order: Google Gemini -> Groq -> OpenRouter -> (Optional Local Ollama)

# Primary Hosted LLM Provider: Google Gemini
# Get free API Key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Secondary Hosted LLM Provider: Groq Cloud (Ultra-fast Inference)
# Get free API Key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Tertiary Hosted LLM Provider: OpenRouter (Unified Free Models)
# Get free API Key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Local Development Fallback (Optional, no GPU required for production)
OLLAMA_MODEL=llama3
ENABLE_OLLAMA_FALLBACK=false

# Global LLM Execution Budget (caps total requests across all combined providers)
LLM_CALL_BUDGET=50
